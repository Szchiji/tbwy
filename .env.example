# ── Telegram Bot ────────────────────────────────────────────────
TELEGRAM_TOKEN=your_bot_token_here
MY_CHAT_ID=your_admin_chat_id_here
CHANNEL_ID=your_channel_id_here
BOT_USERNAME=your_bot_username_here

# ── Web App ──────────────────────────────────────────────────────
BASE_URL=https://your-app.up.railway.app
ADMIN_KEY=change_me_to_a_strong_secret

# ── Environment (set to "dev" to skip Telegram initData HMAC check)
ENV=production

# ── AI Scoring (optional — leave blank to use default score 75) ──
# Get Grok API key from https://console.x.ai/
GROK_API_KEY=

# Get TongYi API key from https://dashscope.aliyuncs.com/
TONGYI_API_KEY=
